{
	"name": "advanced-technology",
	"version": "5.0.0",
	"description": "Custom WP theme for CNO sites",
	"main": "wp-content/themes/advanced-technology/src/index.js",
	"prettier": "@wordpress/prettier-config",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"engines": {
		"node": ">= 24",
		"npm": ">= 12"
	},
	"scripts": {
		"build": "wp-scripts build",
		"check-engines": "wp-scripts check-engines",
		"packages-update": "wp-scripts packages-update",
		"lint:css": "npx stylelint '**/*.scss' '**/*.css' --fix",
		"lint:js": "npx eslint --fix",
		"start": "wp-scripts start"
	},
	"author": "Choctaw Nation of Oklahoma",
	"license": "ISC",
	"dependencies": {
		"@choctawnationofoklahoma/lite-vimeo": "^1.3.1",
		"@choctawnationofoklahoma/wp-flex-reverse-toggle": "^1.1.2",
		"aos": "^2.3.4",
		"bootstrap": "^5.3.8",
		"masonry-layout": "^4.2.2",
		"swiper": "^14.3.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/blocks": "^16.1.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/data": "^10.56.0",
		"@wordpress/editor": "^15.1.0",
		"@wordpress/eslint-plugin": "^27.0.0",
		"@wordpress/hooks": "^4.56.0",
		"@wordpress/scripts": "^36.0.0",
		"eslint": "^9",
		"globals": "^17.4.0",
		"stylelint": "^17.6.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-scss": "^7.0.0"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true,
		"@parcel/watcher@2.6.0": true,
		"core-js@3.50.0": true,
		"core-js-pure@3.50.0": true,
		"unrs-resolver@1.12.2": true
	}
}
